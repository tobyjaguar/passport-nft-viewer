export struct ItemRow {
    title: string,
    subtitle: string,
    detail: string,
    loadable: bool,
}

export struct TraitRow {
    label: string,
    value: string,
}

export global Callbacks {
    // ---- Source screen ----
    in property <string> status: "(starting…)";
    in property <string> owner: "";
    in property <string> provenance: "";
    in property <[ItemRow]> items: [];
    // 0 = USB drive, 1 = Airlock
    callback load-from(int);

    // ---- Gallery screen ----
    // 0 = source, 1 = gallery
    in property <int> screen: 0;
    in property <image> current-image;
    in property <string> current-title: "";
    in property <string> current-collection: "";
    in property <string> current-position: "";
    in property <string> current-description: "";
    in property <string> current-error: "";
    // traits pre-grouped into rows (2 per row) so they wrap on a 480px screen
    in property <[[TraitRow]]> current-trait-rows: [];
    // details sheet over the picture: hidden when an item opens, middle tap toggles
    in-out property <bool> sheet-visible: false;
    // one-time "tap for details" hint, cleared by a timer or the first toggle
    in-out property <bool> hint-visible: false;
    callback open-item(int);
    callback next-item();
    callback prev-item();
    callback close-gallery();
}
